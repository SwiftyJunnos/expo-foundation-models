# Exclude all top-level hidden directories by convention
/.*/

# Exclude tarballs generated by `npm pack`
/*.tgz

# Test files
__mocks__
__tests__

# Documentation (users can view on GitHub)
/docs/

# Config files
/.eslintrc.js
/jest.config.js
/jest.setup.js
/tsconfig.json

# Meta files
/CHANGELOG.md
/ROADMAP.md
/bun.lock

# Build/test artifacts
/android/src/androidTest/
/android/src/test/
/android/build/

# Example app
/example/
